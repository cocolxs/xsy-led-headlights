# ======================================
# 环境变量清单 - 部署到 Render 时使用
# 复制此文件为 .env 并填写实际值
# ======================================

# ---- 基础配置 ----
NODE_ENV=production
SERVER_HOST=0.0.0.0
SERVER_PORT=10000

# ---- 数据库连接（Render PostgreSQL）----
# Render 会自动提供 DATABASE_URL 环境变量，格式如下：
# postgresql://<user>:<password>@<host>:<port>/<dbname>?ssl=true
DATABASE_URL=

# ---- 应用标识（可选，用于后台标题）----
APP_NAME=XSY LED Headlights
APP_URL=

# ---- 后台管理员初始账号（部署后首次创建用）----
# 部署完成后在 Render Dashboard 的 Shell 里执行种子脚本即可创建
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here
ADMIN_NAME=Administrator

# ---- 询盘通知邮箱（可选，有询盘时通知到该邮箱）----
NOTIFICATION_EMAIL=info@xsy-led.com

# ---- UTM 追踪（可选，默认已开启）----
ENABLE_UTM_TRACKING=true

# ---- SSL（Render 自动处理 HTTPS，无需配置）----
